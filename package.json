{
  "name": "heartbeat",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Single-user local relationship and interaction graph tooling",
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "contacts:collect": "node --import tsx scripts/contacts/collect.ts",
    "contacts:email": "node --import tsx scripts/contacts/email.ts",
    "contacts:google": "node --import tsx scripts/contacts/google.ts",
    "contacts:messenger": "node --import tsx scripts/contacts/messenger.ts",
    "contacts:text-xml": "node --import tsx scripts/contacts/text-xml.ts",
    "contacts:operate": "node --import tsx scripts/contacts/operations.ts",
    "contacts:review": "node --import tsx scripts/contacts/identity-review.ts",
    "contacts:whatsapp": "node --import tsx scripts/contacts/whatsapp.ts",
    "contacts:curate": "node --import tsx scripts/contacts/curated.ts",
    "contacts:audience": "node --import tsx scripts/contacts/audience.ts",
    "contacts:prayer": "node --import tsx scripts/contacts/prayer.ts",
    "contacts:aggregate": "node --import tsx scripts/contacts/aggregate.ts",
    "contacts:summary": "node --import tsx scripts/contacts/summary.ts",
    "contacts:graph": "node --import tsx scripts/contacts/graph.ts",
    "contacts:reconnect": "node --import tsx scripts/contacts/reconnection.ts",
    "contacts:opportunities": "node --import tsx scripts/contacts/opportunities.ts",
    "test:contacts": "node --import tsx scripts/test.ts scripts/contacts",
    "test": "node --import tsx scripts/test.ts scripts",
    "check:private": "node --import tsx scripts/check-private-boundary.ts",
    "check": "npm run typecheck && npm run check:private",
    "check:operations": "npm run typecheck",
    "check:summary": "npm run typecheck",
    "check:prayer": "npm run typecheck",
    "check:audience": "npm run typecheck",
    "check:graph": "npm run typecheck",
    "check:reconnection": "npm run typecheck",
    "check:opportunities": "npm run typecheck",
    "ci": "npm run check && npm test",
    "typecheck": "tsc --noEmit"
  }
}
