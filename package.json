{
  "name": "heartbeat",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user local relationship and interaction graph tooling",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "contacts:collect": "node scripts/contacts/collect.cjs",
    "contacts:email": "node scripts/contacts/email.cjs",
    "contacts:google": "node scripts/contacts/google.cjs",
    "contacts:messenger": "node scripts/contacts/messenger.cjs",
    "contacts:text-xml": "node scripts/contacts/text-xml.cjs",
    "contacts:operate": "node scripts/contacts/operations.cjs",
    "contacts:review": "node scripts/contacts/identity-review.cjs",
    "contacts:whatsapp": "node scripts/contacts/whatsapp.cjs",
    "contacts:curate": "node scripts/contacts/curated.cjs",
    "contacts:audience": "node scripts/contacts/audience.cjs",
    "contacts:prayer": "node scripts/contacts/prayer.cjs",
    "contacts:aggregate": "node scripts/contacts/aggregate.cjs",
    "contacts:summary": "node scripts/contacts/summary.cjs",
    "contacts:graph": "node scripts/contacts/graph.cjs",
    "contacts:reconnect": "node scripts/contacts/reconnection.cjs",
    "contacts:opportunities": "node scripts/contacts/opportunities.cjs",
    "test:contacts": "node --test scripts/contacts",
    "test": "node --test scripts",
    "check:private": "node scripts/check-private-boundary.cjs",
    "check": "node scripts/check-syntax.cjs && npm run check:private",
    "check:operations": "node --check scripts/contacts/operations.cjs && node --check scripts/contacts/operations.test.cjs",
    "check:summary": "node --check scripts/contacts/summary.cjs && node --check scripts/contacts/summary.test.cjs",
    "check:prayer": "node --check scripts/contacts/prayer.cjs && node --check scripts/contacts/prayer.test.cjs",
    "check:audience": "node --check scripts/contacts/audience.cjs && node --check scripts/contacts/audience.test.cjs",
    "check:graph": "node --check scripts/contacts/graph.cjs && node --check scripts/contacts/graph.test.cjs",
    "check:reconnection": "node --check scripts/contacts/reconnection.cjs && node --check scripts/contacts/reconnection.test.cjs",
    "check:opportunities": "node --check scripts/contacts/opportunities.cjs && node --check scripts/contacts/opportunities.test.cjs",
    "ci": "npm run check && npm test"
  }
}
